// Type-checks the Datadog chunk and its Vite build helper: tsc -p tsconfig.dd.json
{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "es2020"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["vite/client", "node"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["datadog-chunk.ts", "vite/datadogChunk.ts"]
}
