// Type-checks the Datadog chunk and the Vite plugin that bundles it (vite.build.ts)
{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noImplicitAny": true,
    "module": "esnext",
    "target": "es2020",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"]
  },
  "include": ["datadog-chunk.ts", "vite.build.ts"]
}
