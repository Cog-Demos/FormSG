// Type-checks the Datadog chunk entry and the build config that bundles it
// (see vite.build.mts): `npx tsc -p tsconfig.dd.json`
{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["vite/client", "node"],
    "strict": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["datadog-chunk.ts", "vite.build.mts"]
}
