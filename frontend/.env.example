# Vite only exposes variables prefixed with VITE_ to the client bundle.
# Copy to .env.local (git-ignored) for local overrides.
# VITE_APP_VERSION is injected from npm_package_version by vite.config.ts.

# Base URL of the deployed app (used for Growthbook / debug flows)
VITE_APP_URL=
# API base path override (defaults to /api/v3)
VITE_APP_BASE_URL=
# Google Analytics tracking ID (leave empty to disable GA locally)
VITE_APP_GA_TRACKING_ID=
# formsg SDK mode: production, staging or development (defaults to MODE)
VITE_APP_FORMSG_SDK_MODE=
VITE_APP_GROWTHBOOK_CLIENT_KEY=
# Datadog RUM / logs (read in datadog-chunk.ts and App.tsx)
VITE_APP_DD_RUM_APP_ID=
VITE_APP_DD_RUM_CLIENT_TOKEN=
VITE_APP_DD_RUM_ENV=
VITE_APP_DD_SAMPLE_RATE=
